# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Database (Coolify Postgres or local docker-compose)
DATABASE_URL=postgresql://voyara:voyara@127.0.0.1:5432/voyara?schema=public

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional imagery
UNSPLASH_ACCESS_KEY=

# Seed accounts (used by prisma seed)
SEED_ADMIN_EMAIL=admin@voyara.app
SEED_ADMIN_PASSWORD=AdminVoyara123!
SEED_PROVIDER_EMAIL=provider@voyara.app
SEED_PROVIDER_PASSWORD=ProviderVoyara123!
SEED_TRAVELER_EMAIL=traveler@voyara.app
SEED_TRAVELER_PASSWORD=TravelerVoyara123!
